@echo off
rem Compiles src\Features\RendererShaders.hlsl into src\Features\RendererShaders.hpp
rem Needs fxc.exe from the Windows 10 SDK.
setlocal
set "FXC=%ProgramFiles(x86)%\Windows Kits\10\bin\10.0.19041.0\x86\fxc.exe"
if not exist "%FXC%" (
	for /f "delims=" %%f in ('dir /b /s "%ProgramFiles(x86)%\Windows Kits\10\bin\fxc.exe" 2^>nul ^| findstr /i "\\x86\\"') do set "FXC=%%f"
)
set "SRC=%~dp0..\src\Features\RendererShaders.hlsl"
set "OUT=%~dp0..\src\Features\RendererShaders.hpp"
set "TMP=%TEMP%\sar_shaders"
mkdir "%TMP%" 2>nul

echo // Generated by tools/gen_renderer_shaders.bat from RendererShaders.hlsl - do not edit> "%OUT%"
echo #pragma once>> "%OUT%"
for %%e in (ps_y ps_c ps_uv ps_acc_first ps_acc ps_copy) do (
	"%FXC%" /nologo /T ps_2_0 /O3 /E %%e /Vn g_%%e /Fh "%TMP%\%%e.h" "%SRC%" || exit /b 1
	type "%TMP%\%%e.h" >> "%OUT%"
)
echo done
